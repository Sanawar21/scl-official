# SCL platform configuration
# Copy this file to `.env` and adjust. `.env` is auto-loaded by app/config.py
# at startup (real environment variables always win over .env values).

# Flask session secret — use a long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SCL_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database path (default: data/scl.db).
# Relative paths resolve from the project root (app/config.py).
SCL_DB_PATH=data/demo.db

# Built-in admin account, seeded on first boot if no admin exists.
SCL_ADMIN_USERNAME=admin
SCL_ADMIN_PASSWORD=demo123
